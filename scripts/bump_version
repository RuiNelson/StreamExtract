#!/usr/bin/env python3
"""Update the CLI, library and GUI version without changing dependency versions."""

import argparse
from pathlib import Path
import re
import sys


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("version", help="new version in X.Y.Z format (without a v prefix)")
    args = parser.parse_args()
    if not re.fullmatch(r"(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)", args.version):
        parser.error("version must be X.Y.Z with no leading zeroes (for example, 2.3.0)")

    root = Path(__file__).resolve().parent.parent
    updates = (
        ("CMakeLists.txt", r"(project\(StreamExtract\s+VERSION\s+)([0-9.]+)"),
        ("gui/src-tauri/Cargo.toml", r'(\[package\]\s+name = "StreamExtract"\s+version = ")([^"\n]+)'),
        ("gui/src-tauri/Cargo.lock", r'(\[\[package\]\]\s+name = "StreamExtract"\s+version = ")([^"\n]+)'),
        ("src/app_version.hpp", r'("StreamExtract )([0-9.]+)(?= \()'),
        ("src/capi/streamextract.h", r'("StreamExtract )([0-9.]+)(?= \()'),
        ("gui/src-tauri/src/ffi.rs", r'("StreamExtract )([0-9.]+)(?= \()'),
    )

    # Read and validate every location before writing any changes.
    changes = []
    for relative, pattern in updates:
        path = root / relative
        original = path.read_bytes()
        contents = original.decode("utf-8")
        contents, count = re.subn(pattern, lambda match: match[1] + args.version, contents)
        if count != 1:
            raise ValueError(f"{relative}: expected one version location, found {count}")
        updated = contents.encode("utf-8")
        if updated != original:
            changes.append((path, updated))

    for path, updated in changes:
        path.write_bytes(updated)
        print(f"Updated {path.relative_to(root)}")
    print(f"Version: {args.version} ({len(changes)} files updated)")


if __name__ == "__main__":
    try:
        main()
    except (OSError, UnicodeError, ValueError) as error:
        print(f"bump_version: {error}", file=sys.stderr)
        sys.exit(1)
